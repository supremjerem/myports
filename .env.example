# portsd remote agent — configuration (Phase 3, not yet implemented)
# Copy to .env and adjust. All values have safe defaults; the agent binds to
# loopback only unless MYPORTS_BIND is changed explicitly.

# Interface to bind. 127.0.0.1 = this machine only. 0.0.0.0 = reachable on the LAN.
MYPORTS_BIND=127.0.0.1

# TCP port the agent listens on.
MYPORTS_PORT=7333

# When true, paired remote clients may view ports but not kill anything.
MYPORTS_READONLY=false
