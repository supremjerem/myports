<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- MyPorts runs `lsof` and signals arbitrary user processes; it cannot be
	     sandboxed. Distribution is Developer ID + notarization, not the App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
